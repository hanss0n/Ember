[Desktop Entry]
Name=Ember
GenericName=Night Light
Comment=Shows whether Ember is warming the screen and switches modes
Type=Application
Exec=cosmic-applet-ember
Icon=weather-clear-night-symbolic
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Night;Light;Ember;
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
